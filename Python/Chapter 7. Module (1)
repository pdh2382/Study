# random 모듈
import random
print(random.random()) # 0 <= x < 1.0 사이의 float값 리턴
print(random.uniform(10, 20)) # 지정한 범위 사이의 float값 리턴
print(random.randrange(10)) # 0부터 max 사이의 int값 리턴
print(random.randrange(10, 20)) # 10부터 20 사이의 int값 리턴
print(random.choice([1,2,3,4,5])) # 리스트 내부의 요소 랜덤선택
print(random.shuffle([1,2,3,4,5])) # 리스트 내부의 요소 섞기
print(random.sample([1,2,3,4,5], k=2)) # 리스트 내부의 요소 중 k개 뽑기


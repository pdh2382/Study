# os모듈
import os

print(os.name) # 현재 운영체제
print(os.getcwd()) # 현재 폴더
print(os.listdir()) # 현재 폴더 내부의 요소

os.mkdir("hello") # 폴더를 만들고
os.rmdir("hello") # 지움

with open("original.txt", "w") as file:
  file.write("hello")
os.rename("original.txt", "new.txt") # 파일 이름 변경

os.remove("new.txt") # 파일 삭제(unlink도 동일한 역할)

# datetime 모듈
import datetime

print(" 현재 시각 출력")
now = datetime.datetime.now()
print(now.year, "년")
print(now.month, "월")
print(now.day, "일")
print(now.hour, "시")
print(now.minute, "분")
print(now.second, "초")
print()

# 포맷에 맞게 시간 출력
output_a = now.strftime("%Y.%m.%d %H:%M:%S")
output_b = "{}년 {]월 {}일 {}시 {}분 {]초".format(now.year,\
    now.month, \
    now.day, \ 
    now.hour, \
    now.minute, \ 
    now.second)
output_c = now.strftime("%Y{} %m{} %d{} %H{} %M{} %S{}").format(*"년월일시분초")
# 한글은 strftime에서 제공하지 않아서 다른 방법을 사용함.

# 특정 시간 이후의 시간 구하기
after = now + datetime.timedelta(\
    weeks=1,\
    days=1,\
    hours=1,\
    minutes=1,\
    seconds=1)
print(after.strftime("%Y{} %m{} %d{} %H{} %M{} %S{}".format(*"년월일시분초"))

# 특정 시간 요소 교체하기
output = now.replace(year=(now.year+1))
print(output.strftime("%Y{} %m{} %d{} %H{} %M{} %S{}".format(*"년월일시분초"))


